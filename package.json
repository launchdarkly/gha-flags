{
  "name": "gha-flags",
  "version": "1.1.0",
  "description": "Evaluate LaunchDarkly flags in your GitHub Action workflow.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "docs": "node scripts/gen-docs.mjs && oxfmt README.md",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build && git diff --exit-code dist/ && npm run docs && git diff --exit-code README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/launchdarkly/gha-flags.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache 2.0",
  "bugs": {
    "url": "https://github.com/launchdarkly/gha-flags/issues"
  },
  "homepage": "https://github.com/launchdarkly/gha-flags#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@launchdarkly/node-server-sdk": "^9.13.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vite": "^8.0.5"
  }
}
