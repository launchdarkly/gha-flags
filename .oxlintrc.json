{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error"
  },
  "ignorePatterns": ["dist/**"]
}
